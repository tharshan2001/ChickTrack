# ChickTrack backend environment
# Copy this file to .env and replace placeholder values for local development.

SPRING_PROFILES_ACTIVE=local

# PostgreSQL
POSTGRES_DB=chicktrack
POSTGRES_USER=chicktrack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chicktrack
SPRING_DATASOURCE_USERNAME=chicktrack
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_FLYWAY_ENABLED=true

# OAuth2 authorization server
OAUTH_ISSUER=http://localhost:8080
OAUTH_ADMIN_USERNAME=admin
OAUTH_ADMIN_PASSWORD=change-me
OAUTH_MOBILE_CLIENT_ID=chicktrack-mobile
OAUTH_MOBILE_REDIRECT_URI=chicktrack://oauth2/callback

# S3-compatible storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=chicktrack-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Firebase
FIREBASE_CREDENTIALS_PATH=

# Sentry
SENTRY_DSN=
