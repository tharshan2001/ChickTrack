# Copy to deploy/.env on the server and fill in every value. Never commit deploy/.env.

# Public hostname of the API; its DNS A record must point at this server.
API_DOMAIN=api.cloudbox.my
# Let's Encrypt expiry notices go here
LETSENCRYPT_EMAIL=

# PostgreSQL (internal to the stack)
POSTGRES_DB=chicktrack
POSTGRES_USER=chicktrack
# openssl rand -base64 24
POSTGRES_PASSWORD=

# The owner (main admin) seeded on first start. At least 12 characters.
OAUTH_ADMIN_USERNAME=owner
OAUTH_ADMIN_PASSWORD=

# Mobile app sign-in redirect (comma-separated for several)
OAUTH_MOBILE_CLIENT_ID=chicktrack-mobile
OAUTH_MOBILE_REDIRECT_URI=chicktrack://oauth2/callback
OAUTH_JWK_KEY_ID=chicktrack-1

# Optional
SENTRY_DSN=
# JAVA_OPTS=-Xmx768m -XX:+ExitOnOutOfMemoryError
